{
  "name": "vomp-demo-plugin",
  "version": "1.2.3",
  "path": "/tmp/vomp-fixt/demo-plugin",
  "manifest": {
    "description": "Demo plugin for visual-omp",
    "features": {
      "alpha": {
        "description": "Alpha feature",
        "default": true
      },
      "beta": {
        "description": "Beta feature"
      }
    },
    "settings": {
      "apiKey": {
        "type": "string",
        "secret": true,
        "description": "API key",
        "env": "DEMO_KEY"
      },
      "level": {
        "type": "enum",
        "values": [
          "low",
          "high"
        ],
        "default": "low"
      },
      "count": {
        "type": "number",
        "min": 1,
        "max": 5
      }
    },
    "version": "1.2.3"
  },
  "enabledFeatures": null,
  "enabled": true
}

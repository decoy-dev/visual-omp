[?2004h[?1l>7[?7l[8m[?u[c]11;?[c]99;i=omp-probe-1:p=?;\[c_25a1;s\[c_tsp;q;{"q":"hello","v":[1],"app":"omp","features":["edit","undo","send"]}\[c[?2031h[?2026$p[c[?2048$p[c[?2031$p[c[?2004$p[c[?1010$p[c[?1011$p[c[28m[?7h8[?5522h[?25l[16t_tsp;o;{"id":"s:1","mode":"inline","title":"omp","role":"omp.session"}\_tsp;f;{"sf":"s:1","s":1,"ops":[["add","main","s:1",null,{"id":"main","k":"col"}],["add","dock","s:1",null,{"id":"dock","k":"col"}],["add","layer","s:1",null,{"id":"layer","k":"col"}],["add","0","dock",null,{"id":"0","k":"row","p":{"role":"omp.hud","justify":"end","hidden":true}}],["add","1","dock",null,{"id":"1","k":"col"}],["add","2","dock",null,{"id":"2","k":"col"}],["add","3","dock",null,{"id":"3","k":"col"}],["add","4","dock",null,{"id":"4","k":"col"}],["add","5","dock",null,{"id":"5","k":"col"}],["add","6","dock",null,{"id":"6","k":"col"}],["add","7","dock",null,{"id":"7","k":"col","c":[{"id":"d","k":"col","p":{"role":"omp.hud.judge"}},{"id":"e","k":"col","p":{"role":"omp.hud.downloads"}}]}],["add","8","dock",null,{"id":"8","k":"col"}],["add","9","dock",null,{"id":"9","k":"col"}],["add","a","dock",null,{"id":"a","k":"col","c":[{"id":"f","k":"col"}]}],["add","b","dock",null,{"id":"b","k":"col","c":[{"id":"g","k":"col","p":{"role":"omp.editor"},"c":[{"id":"g.context","k":"meter","p":{"role":"omp.composer.context","style":"bar","thresholds":{"warn":0.5,"bad":0.9},"title":"Context usage unknown\nNo context window","actions":{"click":"status.context"}}},{"id":"h","k":"row","p":{"gap":"sm","wrap":true,"role":"omp.composer.chips","hidden":true}},{"id":"g.line","k":"row","p":{"role":"omp.composer.line","align":"start","gap":"sm"},"c":[{"id":"g.line/input","k":"editor","p":{"text":"","cursor":0,"sendable":false,"placeholder":"What are we cooking?","maxLines":18}}]},{"id":"g.bar","k":"row","p":{"role":"omp.composer.bar","gap":"sm","align":"center"},"c":[{"id":"g.bar/model","k":"row","p":{"role":"omp.composer.model","gap":"xs","align":"center","title":"Switch model  ⌥P","actions":{"click":"status.model"}},"c":[{"id":"g.bar/model/icon","k":"icon","p":{"name":"model"}},{"id":"g.bar/model/name","k":"text","p":{"spans":[{"t":"no-model","s":"statusLineModel"}],"wrap":"none"}},{"id":"g.bar/model/chev","k":"icon","p":{"name":"chev"}}]},{"id":"g.bar/extras","k":"status","p":{"role":"omp.composer.extras","transparent":true,"grow":1}},{"id":"g.bar/usage","k":"text","p":{"role":"omp.composer.usage","text":"","wrap":"none","actions":{"click":"status.cost"}}},{"id":"g.bar/send","k":"kbd","p":{"role":"omp.composer.send","keys":["enter"],"title":"Send  ⏎","actions":{"click":"submit"}}}]}]}]}],["add","c","dock",null,{"id":"c","k":"col"}],["focus","g.line/input"]]}\[22;2t]0;omp]7501;state=idle:app=omp\]1337;SetUserVar=omp_restore=MQ==]1337;SetUserVar=omp_session_file=L3RtcC92b21wLWZpeHR1cmUvc2Vzc2lvbnMvMjAyNi0xMC0zMFQyMi0xNS0zNi0xMzVaXzAxYTE4ZWUxLWY3YzctNzczMy05ZTEyLWZiNjI1YzNiMWQwMi5qc29ubA==]7;file://localhost/tmp/vomp-fixture q_tsp;f;{"sf":"s:1","s":2,"ops":[["add","i","main",null,{"id":"i","k":"row","p":{"role":"omp.notice.warning","tone":"warning","gap":"sm","align":"start"},"c":[{"id":"i.0","k":"icon","p":{"name":"warning","tone":"warning","aria":"Warning"}},{"id":"i.1","k":"text","p":{"wrap":"word","grow":1,"shrink":1,"spans":[{"t":"No default model selected. Use /login, set an API key environment variable, or select a local model with /model or --model."}]}}]}],["add","j","a",null,{"id":"j","k":"col"}],["set","g.line/input",{"sendable":true}],["del","f"],["settle","i"]]}\[>4;2m]11;?[c_tsp;f;{"sf":"s:1","s":3,"ops":[["add","layer.ov-k","layer",null,{"id":"layer.ov-k","k":"overlay","p":{"anchor":"center","size":"lg","modal":true,"role":"omp.overlay.report","head":"Available Tools"},"c":[{"id":"k","k":"col","p":{"gap":"md"},"c":[{"id":"k.body","k":"col","p":{"role":"omp.report.body"},"c":[{"id":"l","k":"md","p":{"text":"| Tool | Description |\n|------|-------------|\n| `read` | Use `read` for static web; browser only if needed. Put line ranges in `path`, never a separate range/offset/limit parameter: `{\"path\":\"notes.txt:450-455\"}` reads lines 450-455; `{\"path\":\"notes.txt:-5\"}` reads the last 5. Include the selector on every ranged call; repeating a bare path does not advance through the file. Path suffixes: :50 or :50- starts at line 50; :50-200 inclusive; :50+150 counts lines; :-60 last 60; commas join ranges (:5-16,960-973) or individual lines (:19,59). A single non-raw range also shows 1 line before and 3 after (e.g. :50-80 shows 49-83); non-raw reads (comma lists too) may add the open/close line of a cut block; only :raw stays exact. :raw verbatim without anchors/prefixes; combine :2-4:raw or :raw:2-4 for exactly those lines; beside :raw a bare number is that one line (:17:raw), :17-:raw runs on. :conflicts lists one line per unresolved merge block. SVG/SVGZ default text; :img rasterizes an SVG/SVGZ into an image, :raw original. Raster images (PNG, JPEG) need no selector; :img rejects them. Video requires ffmpeg/ffprobe: bare preview grid+metadata, :412 frame, :1h5m42s/:90s/:01:23 time. Sources: - Bare code: declarations only; re-read ONLY footer-named omissions, NEVER guess `..`/`…`. - Selected file: `[foo.ts#1A2B]` snapshot+lines. Copy `[FILENAME#TAG]` for anchored edits; NEVER invent tag. - Directory: complete root; child listings cap at 12 (`… N more`), read child; page via :N-M/:-N. - SQLite: file.db tables; :table schema/rows; :table:key by primary key; ?limit=, ?where=, ?q=SELECT. - Archives: ZIP/JAR/APK/WHL, compressed TAR, RAR/7z/ISO/CAB/DEB/RPM/CPIO/AR/LZH/ARJ/ASAR, compressed streams; member via archive.ext:member/path. - JSON/JSONL/NDJSON: file.json?q=<jq filter>; &raw=true unquoted strings, &compact=true one-line values, &offset=&limit= page results; `&` inside the filter → %26. - PDF/documents: extracted text; notebooks: editable cells; images: decoded inline. URLs: reader text/markdown, :raw original HTML; bare host:port needs trailing slash. |\n| `bash` | Persistent shell: one fact command/pipeline; dependencies use `&&`. Scripts/heredocs/`$(…)`/complex pipelines → `eval`. `cwd`, not `cd`; `pty` only interactive. Internal URIs work as paths for builtins/coreutils, redirects, globs. `async` defers finite results but keeps the deadline (default 300s); `timeout: 0` for watchers and long jobs. No `head`/`tail`/redirection; output trunc by default, full result at `artifact://<id>`. Long-lived services: unique name; ready requires name; no async/timeout; pty defaults true. ready needs log regex or port (both if given); host defaults 127.0.0.1, ready.timeout 30s. Non-`pty` calls still running after 60s (or 1s before `timeout`, if sooner) usually move to background job `bg_N` and keep running to `timeout` (not when the client terminal runs the command or the job cap is reached); the result arrives automatically as a follow-up message. NEVER poll. |\n| `edit` | Hashline patches existing files; new files: `write`. Each file: `[PATH#TAG]`, `TAG` required 4-hex snapshot from latest `read`/`search`. Numbers: original `LINE:TEXT`, never hunk-shifted. <ops> `PUT N.=M:` replace inclusive N–M with `+` body (`N.=N` for one line); `PUT N*:` replace block N. `PUT <N:`/`PUT >N:` insert before/after N (`<1` head, `>$` tail). `PUT >N*:` insert after block N at sibling depth; inside, use `PUT >M:` at closer. `CUT N.=M`/`CUT N*` delete and capture, optionally as `@name`. `PUT <N @name`/`PUT >N @name` paste at gap (omit name for anonymous CUT); `PUT N.=M @name`/`PUT N* @name` paste over range/block (name REQUIRED). Register pastes have NO body; named registers persist across calls. `REM` delete file; `MV DEST` rename after prior edits (quote spaced paths). </ops> <rules> - `:` ops only: body rows `+TEXT` verbatim incl. indent; lone `+` blank. Literal `- item`/`+ item` → `+- item`/`++ item`. NEVER `-`/bare context. Body length independent of range; delete with CUT, not empty PUT. - Touch displayed changed lines only; `…`, `..`, collapsed `N-M:` and out-of-window lines UNSEEN. Re-read first. Tight ranges: split nonadjacent changes; NEVER include keepers or start/end mid-expression/block. Pure addition uses gap PUT. - `*` requires multi-line opener, NEVER closer/last/inner statement; use range/gap for one statement. Anchor first decorator/attribute/doc-comment to include it; standalone comments need explicit range. - Markdown heading blocks run through deeper headings until next same/higher; after section `PUT >N*:`, end body with blank line. - NEVER restyle unrelated code. After EVERY edit tag/numbers change: use edit response or fresh `read`; stale tag/surprise → STOP, re-read. </rules> <example> ``` [greet.py#A1B2] PUT 1*: +@cache +def greet(name): +    print(name) [PLAN.md#3C4D] PUT >2: +- task ``` Cross-file move: `CUT 1* @fn` in source, then `PUT <1 @fn` in destination section. </example> |\n| `ask` | Ask only for materially different tradeoffs the user must decide. Default: act using code/config/docs/history and conventions. Several viable choices: pick conservative/standard, proceed, state choice. <instruction> - Batch related questions; 2–5 distinct options each; short labels, tradeoffs in `description`. - `recommended` auto-adds \" (Recommended)\"; `multi: true` permits multiple selections. - NEVER supply \"Other\": UI adds \"Other (type your own)\". Clarifying custom input? Answer first; re-ask unresolved questions. - Blocks immediately: MUST first emit unseen decision context (findings, diffs, drafts) as assistant text, even when batching `ask` with other tools. </instruction> |\n| `eval` | One cell per call; top-level state persists, including across compaction. Subagents have separate kernels. For 2+ independent items, use a named `workpool()`; results auto-deliver. If blocked, leave `eval` and call `wait`. Python: plain Python subprocess, not IPython (no `get_ipython()`, `obj?`, or `%matplotlib`). Magics like `%pip`, `%load`, `%time` and `!cmd` are rewritten to Python. Top-level `await` works; `asyncio.run(…)` fails. JS: Bun (`Bun.file`, `Bun.write`, `Bun.$`); top-level `await`/`return` work. On error, retry only the failed step; earlier steps may have taken effect. Cell deadline: nonzero `timeout` values clamp to 1–3600 seconds; `0` disables the deadline. A changed supplied deadline is disclosed before execution. Printing an image or figure attaches it. <prelude> Python helpers take kwargs; JS helpers take positional args or ONE trailing options object. ``` print(value, ...)  log(message)  phase(title)  env(key?, value?) — sync read(path, offset?, limit?)  write(path, content); JS: await read(path, offset?, limit?)  await write(path, content) — Python: sync; JS: async output(*ids, format?, query?, offset?, limit?); JS: await output(...ids, { format?, query?, offset?, limit? }) — Python: sync; JS: async wait(handles, timeout?=None, raise_errors?=True); JS: await wait(handles, { timeout?, raiseErrors? }) — Python: sync; JS: async; agent/completion barrier, ordered results; `raise_errors=False` / `raiseErrors: false` retains failures. await tool.<name>(args) — async; session tool; `args` is its parameter object ``` Session tool names: `read`, `bash`, `edit`, `ask`, `eval`, `glob`, `grep`, `task`, `wait`, `todo`, `web_search`, `write`, `ast_edit`, `debug`. </prelude> <namespaces> More globals; `read` the linked docs before first use: - `judge`, `judge_batch`, `completion`: classification, bulk judgment, model calls → `xd://eval/judge` - `%load`, `%pip`, `%bun add`, `budget`, `@tool`/`tool(fn)`: setup, installs, utilities → `xd://eval/helpers` - `agent`, `workpool`: background subagents, DAG waves → `xd://eval/agents` - `browser`: Drive real Chromium tabs from JavaScript or Python Eval with the global `browser` object. → `xd://eval/browser` - `archive`: Read-only local history via the global `archive`: recent projects, past sessions with recaps, searchable prompt history. → `xd://eval/archive` </namespaces> <critical> NEVER repeat successful setup. Kernel-loss notice means reload setup. </critical> |\n| `glob` | Glob files/dirs: `;`-separated paths or internal URLs (`local://*.md`, `omp://**/*.md`); default workspace root. `gitignore` and `hidden` default true; ignored dotfiles need `gitignore: false`. Newest-first by directory; dirs end `/`. Multi-round discovery → Task + scout. |\n| `grep` | Regex: Rust, then PCRE2. `path`: `;`-separated file/dir/glob/URL; default `.`. Default case-sensitive, gitignore respected; `skip` paginates files. File-only selector: `src/foo.ts:50-100`. Literal `\\n`/`\\\\n` enables cross-line. Bare glob `*.ts` matches any depth; `dir/*.ts` only `dir`'s direct children (`dir/**/*.ts` recurses). A `!glob` entry excludes matching files and folders below the searched paths (`src;!**/*.test.ts`). Multi-round search MUST use Task + scout, not chained calls. |\n| `task` | Spawn `tasks[]` concurrently; IDs return immediately. Results auto-deliver; NEVER poll. Completely blocked? Call `wait` to receive the first settled job you started. Coordinate while peers run via `write agent://<id>` (or `agent://all` to broadcast). `read proc://` lists jobs/services; `read proc://<id>` inspects status/output without consuming delivery. `write proc://<id>/kill` cancels/stops; omit `content`. Job IDs are process-local; delivered results expire shortly (~30s), unconsumed results within ~5min. Agent output/transcripts remain readable at `agent://<id>` / `history://<id>`. `write agent://<id>` messages a live agent. `completed`: subagent yielded successfully; claimed artifacts unverified. # Delegation Use most specific agent. Read-only research MUST use `scout` only when files unknown. Prefer one agent to investigate + edit. Omit `agent` only for default (`task`); NEVER specify it. Specialist `agent` selectors belong inside each `tasks[]` item; NEVER put `agent` at the top level. Shared edits need one integration owner; siblings coordinate via `write agent://<id>`. Set interfaces in `context`. Every task MUST skip build/lint/tests/formatters mid-flight; run once afterward. # Inputs `name`: CamelCase ≤32, auto-generated if omitted; address agent by name. `solutionSpace`: describe how open-ended the child's problem is: whether the fix or design is given, or which causes or designs remain open. Volume of work does not widen it; NEVER mention sibling agents or coordination. (`one fix: rename, names given`; `one fix: slice end in paginate`; `single-flight cache load; races easy to miss`; `several retry API shapes; error classes to choose`; `deadlock cause open, no repro`) Historical consults: use `agent: \"seance\"` with `sourceSession` (id/path); optional `model` overrides the saved source model. The source stays unchanged. If the saved model is absent/unavailable, set `model` explicitly. `tools`: eval-defined, run in your kernel. Children start blank; parent IRC steers immediately; large payloads via `local://<path>`, NEVER inline. # Format `context`: shared (`# Goal`, `# Contract` interfaces); NEVER repeat per task. `task`: self-contained (`# Target` files/non-goals, `# Change` steps/APIs, `# Acceptance` observable result). # Available Agents - `scout` (READ-ONLY; investigation only, no edits): MUST be used for exploratory codebase research, rapid code analysis, and broad pattern searches. Fast read-only scout returning compressed context for handoff. - `reviewer`: Code review specialist for quality/security analysis - `security-reviewer`: Read-only security specialist for evidence-backed repository vulnerability discovery - `seance` (READ-ONLY; investigation only, no edits): Read a historical session and nested transcripts to answer a consult. - `task`: General-purpose subagent with full capabilities for delegated multi-step tasks - `sonic`: Low-reasoning agent for strictly mechanical updates or data collection only |\n| `wait` | Wait only when blocked with nothing else to do. Blocks on background jobs/services you started, or on the reply to a message you sent this run; returns on the first result, a message sent to you, or a steering interrupt; a safety cap returns a still-running snapshot. Nothing you started running and no reply owed? Returns at once. Results and messages auto-deliver. NEVER poll while work remains. |\n| `todo` | `todo` NEVER takes a turn of its own: emit it in the same response as your next real tool call (parallel tool calls), `init` beside the first read or action, `done`/`start` beside the next action or check. A response whose only call is `todo` wastes a full model round trip. Tasks identified by verbatim content, NEVER generated IDs (task-1). Unique, stable task/phase names; lost text: view, NEVER guess. Before work, init for 3+ steps, requested task sets, or new instructions. MUST list EVERY user item separately (phased/numbered/bulleted/N); NEVER omit or remember leftovers. After successful mutation: no active means earliest pending starts (phase order); multiple active means only earliest stays. Blocked NEVER starts automatically; unblock returns pending. Done out of order may rewind pointer but NEVER reopen completed. Mark done immediately; follow phase order. External waits (user/agent/service): block with optional reason suppresses stop reminder, starts next pending. Unblock when actionable; append a clearing task for agent-actionable blocker. |\n| `web_search` | Known URLs/programmatic data → `read`. Query: site: or -site:, after: or before: YYYY-MM-DD, inurl:, intitle:, filetype:, \"phrase\", -term, OR. Prefer primary sources; MUST link citations. |\n| `write` | SHOULD `edit` existing files; `write` for required new files or whole-file replacement. NEVER create docs or emojis unless requested. `archive.ext:member`: ZIP/tar families and `.asar` writable, others read-only. `db.sqlite:table`: insert; `db.sqlite:table:key`: JSON update, empty content deletes. |\n| `xd://ast_edit` | Perform AST-aware code edits (structural refactoring) |\n| `xd://debug` | Debug a running process with DAP (debugger adapter protocol) |"}}]},{"id":"k.actions","k":"row","p":{"role":"omp.actions","gap":"sm","align":"center"},"c":[{"id":"k.actions/0","k":"spacer","p":{"grow":1}},{"id":"k.actions/close","k":"row","p":{"role":"omp.btn","gap":"xs","align":"center","actions":{"click":"close"},"title":"Close  esc"},"c":[{"id":"k.actions/close/0","k":"text","p":{"text":"Close"}},{"id":"k.actions/close/1","k":"kbd","p":{"keys":["escape"]}}]}]}]}]}],["focus",null]]}\_tsp;f;{"sf":"s:1","s":4,"ops":[["del","layer.ov-k"],["focus","g.line/input"]]}\_tsp;f;{"sf":"s:1","s":5,"ops":[["add","m","main",null,{"id":"m","k":"toast","p":{"text":"Closing session…","ttl":2400,"role":"omp.toast.status"}}],["add","n","a",null,{"id":"n","k":"col"}],["del","j"],["settle","m"]]}\_tsp;x;{"id":"s:1","keep":true}\]0;π > vomp-tsp-record-GgOYG8[>4;0m[c]1337;SetUserVar=omp_session_file]7501;state=clear\]0;[23;2t[?25h[?2026l[?7h[?1l>[?2004l[?5522l[?1006l[?1003l[?1000l[?2031l[?2026l[?7h[?1l>[?2004l[?2031l[?2048l[?5522l[<u[>4;0m[?9001l[?1006l[?1003l[?1000l[0 q[?25h